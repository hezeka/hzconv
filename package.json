{
  "name": "hzconv",
  "version": "2.0.0",
  "description": "Конвертер изображений, видео и аудио",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently -k \"npm:dev:vue\" \"npm:dev:electron\"",
    "dev:vue": "vite --port 8085 --strictPort",
    "dev:electron": "wait-on tcp:8085 && cross-env NODE_ENV=development electron .",
    "vite:build": "vite build",
    "build": "npm run vite:build && electron-builder",
    "test": "node --test test/*.test.js"
  },
  "build": {
    "appId": "com.example.hzconv",
    "productName": "Hzconv",
    "icon": "src/icon.png",
    "files": [
      "main.js",
      "preload.js",
      "dist/**/*",
      "src/main/**/*",
      "src/shared/**/*",
      "src/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "build"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "asarUnpack": [
      "**/node_modules/sharp/**/*",
      "**/node_modules/@img/**/*",
      "**/node_modules/ffmpeg-static/**/*",
      "**/node_modules/@ffprobe-installer/**/*"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "keywords": [
    "electron",
    "media",
    "converter",
    "ffmpeg",
    "sharp"
  ],
  "author": "HZK",
  "license": "ISC",
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.2",
    "fs-extra": "^11.1.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@vitejs/plugin-vue": "^5.2.3",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "vite": "^6.3.3",
    "vue": "^3.3.0",
    "wait-on": "^9.1.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
