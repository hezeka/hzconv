{
  "name": "hzconv",
  "version": "1.0.0",
  "description": "Конвертер медиафайлов на основе Node.js и Electron",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "dev:vue": "vite --port 8085",
    "dev": "concurrently \"npm run dev:vue\" \"npm run dev:electron\""
  },
  "build": {
    "appId": "com.example.media-converter",
    "productName": "Media Converter",
    "files": [
      "main.js",
      "preload.js",
      "dist/**/*",
      "src/main/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "build"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "keywords": [
    "electron",
    "media",
    "converter",
    "ffmpeg",
    "sharp"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "element-plus": "^2.3.0",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.2",
    "fs-extra": "^11.1.1",
    "path-browserify": "^1.0.1",
    "sharp": "^0.32.6",
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.3",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^25.0.0",
    "electron-builder": "^24.0.0",
    "electron-devtools-installer": "^3.2.0",
    "vite": "^6.3.3"
  }
}

