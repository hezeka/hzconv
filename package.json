{
  "name": "hzconv",
  "version": "2.0.1",
  "description": "Конвертер изображений, видео и аудио",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently -k \"npm:dev:vue\" \"npm:dev:electron\"",
    "dev:vue": "vite --port 8085 --strictPort",
    "dev:electron": "wait-on tcp:8085 && cross-env NODE_ENV=development electron .",
    "vite:build": "vite build",
    "build": "npm run vite:build && electron-builder",
    "test": "node --test test/*.test.js"
  },
  "build": {
    "appId": "io.github.hezeka.hzconv",
    "productName": "Hzconv",
    "icon": "src/icon.png",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "dist/**/*",
      "src/main/**/*",
      "src/shared/**/*",
      "src/icon.png",
      "package.json",
      "!**/node_modules/@img/sharp-*musl*/**",
      "!**/node_modules/@img/sharp-wasm32/**"
    ],
    "asarUnpack": [
      "**/node_modules/sharp/**/*",
      "**/node_modules/@img/**/*",
      "**/node_modules/ffmpeg-static/**/*"
    ],
    "electronLanguages": [
      "ru",
      "en-US"
    ],
    "directories": {
      "output": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.graphics-design"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics"
    },
    "publish": null
  },
  "keywords": [
    "electron",
    "media",
    "converter",
    "ffmpeg",
    "sharp"
  ],
  "author": "HZK",
  "license": "ISC",
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.2",
    "fs-extra": "^11.1.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@vitejs/plugin-vue": "^5.2.3",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "vite": "^6.3.3",
    "vue": "^3.3.0",
    "wait-on": "^9.1.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hezeka/hzconv.git"
  },
  "homepage": "https://github.com/hezeka/hzconv"
}
